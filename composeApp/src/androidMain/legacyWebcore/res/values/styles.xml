<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default XDK payment chrome: no system ActionBar; optional in-layout Toolbar. -->
    <style name="Theme.Xdk" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">#003BA0</item>
        <item name="colorPrimaryDark">#003BA0</item>
        <item name="android:actionMenuTextColor">#44D62C</item>
        <item name="actionMenuTextColor">#44D62C</item>
    </style>

    <style name="Theme.Fullscreen" parent="Theme.Xdk">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
