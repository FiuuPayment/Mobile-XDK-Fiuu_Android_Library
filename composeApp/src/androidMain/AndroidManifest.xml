<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <package android:name="com.samsung.android.spay" />
        <package android:name="com.samsung.android.samsungpay.gear" />
        <package android:name="com.samsung.android.wallet" />
    </queries>

    <application>
        <!-- Legacy Webcore Payment Activities -->
        <activity
            android:name="com.fiuu.xdk.PaymentActivity"
            android:theme="@style/Theme.Xdk"
            android:configChanges="orientation|screenSize"
            android:exported="false" />
        <activity
            android:name="com.fiuu.xdk.googlepay.ActivityGP"
            android:theme="@style/Theme.Xdk"
            android:configChanges="orientation|screenSize"
            android:exported="false" />
        <activity
            android:name="com.fiuu.xdk.googlepay.WebActivity"
            android:theme="@style/Theme.Xdk"
            android:exported="false" />

        <!-- Required by the Samsung Pay SDK's partner validation (SpayValidity) — without this,
             getSamsungPayStatus fails with PARTNER_INFO_INVALID (-99), "SDK API Level was not defined". -->
        <meta-data
            android:name="spay_sdk_api_level"
            android:value="2.22" />

        <!-- Required by the Google Pay API. Declared here (not in each host app) so manifest
             merging carries it into every consuming app automatically. -->
        <meta-data
            android:name="com.google.android.gms.wallet.api.enabled"
            android:value="true" />
    </application>
</manifest>