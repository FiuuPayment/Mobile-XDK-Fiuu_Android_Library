# Copy this file to env.properties.
# env.properties is gitignored and is read by the sample app at build time.
#
# Merchant credentials are not build settings. Enter username, password,
# app name, merchant id, and verification key in the sample app MERCHANT tab.
# The verification key stays on the client because Google Pay signs with it there.
#
# Active environment: uat, sandbox, or prod
# uat      -> mp_core_env 3, https://uat-xdk.fiuu.com/
# sandbox  -> mp_core_env 4, https://sandbox-xdk.fiuu.com/
# prod     -> mp_core_env 2, https://xdk.fiuu.com/

env=uat

# expressmode: true or false
# channel: payment channel code, for example multi, TNG-EWALLET, maybank2u

uat.channel=multi
uat.expressmode=false

sandbox.channel=multi
sandbox.expressmode=false

prod.channel=multi
prod.expressmode=false
