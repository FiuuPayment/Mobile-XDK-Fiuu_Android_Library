# Copy this file to .env and fill in the credentials for the environment you will test.
# .env is gitignored. Do not commit it.
# Rebuild the app after changing .env. These values are compiled into the app.

# Sandbox (mp_build_mode = 4)
SANDBOX_MERCHANT_ID=
SANDBOX_VERIFICATION_KEY=
SANDBOX_USERNAME=
SANDBOX_PASSWORD=
SANDBOX_APP_NAME=mobile
SANDBOX_GP_MERCHANT_ID=

# UAT (mp_build_mode = 3)
UAT_MERCHANT_ID=
UAT_VERIFICATION_KEY=
UAT_USERNAME=
UAT_PASSWORD=
UAT_APP_NAME=mobile
UAT_GP_MERCHANT_ID=

# Production (mp_build_mode = 2)
PROD_MERCHANT_ID=
PROD_VERIFICATION_KEY=
PROD_USERNAME=
PROD_PASSWORD=
PROD_APP_NAME=mobile
PROD_GP_MERCHANT_ID=

# Payer details prefilled on the payment screen. Optional.
BILL_NAME=
BILL_EMAIL=
BILL_MOBILE=
